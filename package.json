    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:backend": "node scripts/test-backend.mjs",
    "setup:env": "node scripts/configure-env.mjs",
    "backend:start": "node scripts/backend.mjs start",
    "backend:stop": "node scripts/backend.mjs stop",
    "backend:status": "node scripts/backend.mjs status",
    "test:accounts": "node scripts/test-accounts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:performance": "node scripts/measure-performance.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/dm-sans": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
